# Photo Viewer configuration. Copy to `.env` and edit.

# Pinned image version. Bump to upgrade.
IMAGE_TAG=1.0.0

# Absolute path on this host to the family photo library.
# macOS example:    /Users/you/Pictures/Family
# Linux example:    /mnt/photos
# Windows example:  C:\Users\you\Pictures\Family
# Synology example: /volume1/photo
# QNAP example:     /share/Multimedia
LIBRARY_PATH=

# Port the app listens on inside your LAN.
PORT=3000

# Random string used to sign session cookies. The install script generates one
# automatically if you leave this blank.
SESSION_SECRET=

# Photo Viewer AppLauncher launch config. Copy to config/applauncher.env and edit.
# This file is read by the target-owned AppLauncher package scripts.

# Numbered image tag to run. Keep aligned with VERSION unless testing a local build.
IMAGE_TAG=1.0.3

# AppLauncher host port. Registered in the shared local port registry.
PORT=4820

# Absolute path on this host to the photo library. Mounted read-only at /library.
LIBRARY_PATH=

# Random string used to sign session cookies. Use 32+ characters.
# Do not commit config/applauncher.env.
SESSION_SECRET=
